# Environment variables for the Portainer stack (compose.yml).

# Use hex/alphanumeric only (e.g. `openssl rand -hex 16`); it is embedded in a connection URL.
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
BETTER_AUTH_SECRET=change-me
# Optional, default to pingis.emiljo.com
#PUBLIC_URL=https://pingis.emiljo.com
#PUBLIC_WS_URL=wss://pingis.emiljo.com
# Host port (127.0.0.1 only) the existing cloudflared tunnel points at
#PROXY_PORT=8090
# Optional: where daily DB dumps are written on the host
#BACKUP_DIR=/tank/shared/nas-shared/backups/pingis
