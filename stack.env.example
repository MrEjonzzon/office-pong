# Environment variables for the Portainer stack (compose.yml).

# Use hex/alphanumeric only (e.g. `openssl rand -hex 16`); it is embedded in a connection URL.
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
BETTER_AUTH_SECRET=change-me
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token
TUNNEL_TOKEN=

# Optional, default to office-pong.emiljo.com
#PUBLIC_URL=https://office-pong.emiljo.com
#PUBLIC_WS_URL=wss://office-pong.emiljo.com
